# Copy to .env and change the values. .env is ignored by git; never commit real secrets.

# Required: the key a client must send as X-API-Key to write readings. Make it long and random, for example
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LIFECITY_INGEST_API_KEY=change-me-to-a-long-random-string

# Used by docker compose for the local database.
POSTGRES_PASSWORD=change-me-too

# Running the API outside docker (from api/): point it at any Postgres, or SQLite for a quick look.
# LIFECITY_DATABASE_URL=postgresql+psycopg://lifecity:change-me-too@localhost:5432/lifecity
# LIFECITY_DATABASE_URL=sqlite:///./lifecity.db
